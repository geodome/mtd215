{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/homebrew/include"
            ],
            "defines": [],
            "cStandard": "c17",
            "intelliSenseMode": "macos-gcc-arm64",
            "cppStandard": "c++23",
